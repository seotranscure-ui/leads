# Optional. Normally you do not need this file at all: `npm run login` stores the
# connection, and settings go in the Claude MCP config's "env" block (see README).
#
# NEVER put a service_role / sb_secret_... key here. The server refuses to start
# with one — it signs in as a tracker user so Row Level Security stays on and
# every edit is attributed to a person. See SECURITY.md.

# How much Claude may do: read | write | admin
LEADS_MCP_MODE=read

# Workspace used when a question does not name one.
LEADS_MCP_DEFAULT_PROJECT=transcure

# Connection — only needed to override what `npm run login` stored.
# The anon key is public by design; it is already in the website bundle.
# SUPABASE_URL=https://tmpndupgmwkalgrztrgp.supabase.co
# SUPABASE_ANON_KEY=

# Unattended sign-in, instead of `npm run login`. Prefer the stored session:
# this writes a password to disk in plain text.
# LEADS_MCP_EMAIL=
# LEADS_MCP_PASSWORD=

# Ceiling on how many leads one write call may touch.
# LEADS_MCP_MAX_BATCH=200

# Set to 0 to stop journaling writes to ~/.config/leads-mcp/audit.log
# LEADS_MCP_AUDIT=1
