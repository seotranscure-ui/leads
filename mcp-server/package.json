{
  "name": "leads-tracker-mcp-server",
  "version": "2.0.0",
  "description": "MCP server for the Lead Tracker (Transcure / Macralytics) — read, write and analyse leads, follow-ups and workspace settings from Claude.",
  "type": "module",
  "bin": { "leads-tracker-mcp-server": "dist/index.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "login": "tsx scripts/login.ts",
    "logout": "tsx scripts/login.ts --logout",
    "doctor": "tsx scripts/doctor.ts",
    "smoke": "tsx scripts/smoke.ts",
    "selftest": "tsx scripts/selftest.ts"
  },
  "engines": { "node": ">=20.3" },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@supabase/supabase-js": "^2.45.4",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
